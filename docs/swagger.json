                        "description": "Erro interno",
                        "schema": {
                            "$ref": "#/definitions/github_com_diegodesousas_greeter_internal_infra_http.DefaultResponse"
                        }
                    }
                }
            }
        },
        "/greetings/search": {
            "get": {
                "description": "Retorna saudações cujo nome contenha o termo buscado, ignorando maiúsculas/minúsculas e acentos",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "greetings"
                ],
                "summary": "Busca saudações por nome",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Termo de busca pelo nome",
                        "name": "name",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Número da página (\u003e= 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Itens por página (1-100)",
                        "name": "per_page",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
