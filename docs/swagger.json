            "get": {
                "description": "Retorna a lista de saudações registradas, com paginação",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "greetings"
                ],
                "summary": "Lista saudações paginadas",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Número da página (\u003e= 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Itens por página (1-100)",
                        "name": "per_page",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_diegodesousas_greeter_internal_application_list_greetings.Output"
                        }
                    },
                    "422": {
                        "description": "Erro de validação",
                        "schema": {
                            "$ref": "#/definitions/github_com_diegodesousas_greeter_internal_infra_http.DefaultResponse"
                        }
